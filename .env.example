# Required by SQL Server. Replace this with a unique, strong local password.
DB_PASSWORD=Change_me_123!

# Local ports
FRONTEND_PORT=3000
API_PORT=8080
SQL_PORT=1433
FRONTEND_ORIGIN=http://localhost:3000

# Application environment (use Production behind HTTPS in a deployed environment).
ASPNETCORE_ENVIRONMENT=Development

# SMTP configuration. Gmail requires an app password when two-step verification is enabled.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_ENABLE_SSL=true
EMAIL_FROM_EMAIL=your-address@gmail.com
EMAIL_FROM_NAME=Aurum
