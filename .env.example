# Required by SQL Server. Replace this with a unique, strong local password.
DB_PASSWORD=Change_me_123!

# Local ports
FRONTEND_PORT=3000
API_PORT=8080
SQL_PORT=1433
MAILPIT_UI_PORT=8025
FRONTEND_ORIGIN=http://localhost:3000

# Application environment (use Production behind HTTPS in a deployed environment).
ASPNETCORE_ENVIRONMENT=Development

# By default, emails are captured locally by Mailpit at http://localhost:8025.
# Override these values to use an external SMTP provider.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_ENABLE_SSL=false
EMAIL_FROM_EMAIL=noreply@aurum.local
EMAIL_FROM_NAME=Aurum
